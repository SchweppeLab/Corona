<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Deliberately no <clear/>: sources from the machine-level NuGet.Config (a developer's
         local Nova / Schweppe Lab feeds) stay in effect. CI adds the Nova release bundle as a
         source at build time; see .github/workflows. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Packages vendored in this repo because their source repo is private (LandmineUI).
         See nuget/README.md. -->
    <add key="Corona-Vendored" value="nuget" />
  </packageSources>
</configuration>
