<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- Stays AnyCPU whatever Platform the solution builds with; the package must not be
         x64-only just because the apps are. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>MStreamer</PackageId>
    <Title>MStreamer: replay mass spectrometry data files as a live acquisition.</Title>
    <Description>Reads an MS data file (Thermo RAW, mzML, mzXML) and broadcasts its scans at their retention times, as if acquired in real time.</Description>
    <PackageTags>mass spectrometry;simulation;real-time</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nova" />
    <PackageReference Include="Nova.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
