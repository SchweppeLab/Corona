<Window x:Class="VirtualMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Corona" Height="878" Width="1140">
    <DockPanel LastChildFill="True">

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button ToolTip="Open MS Files" Command="{Binding LoadCommand}">
                    <Image Source="gfx/file_open_32dp_5F6368_FILL0_wght400_GRAD0_opsz40.png" Width="28" Height="28"/>
                </Button>
                <Button x:Name="DeleteButton" ToolTip="Remove MS Files" Click="DeleteButton_Click" IsEnabled="{Binding CanDelete}">
                    <Image Source="gfx/delete_forever_32dp_5F6368_FILL0_wght400_GRAD0_opsz40.png" Width="28" Height="28"/>
                </Button>
                <Separator/>
                <Button x:Name="AddButton" ToolTip="Add Run" Click="AddButton_Click" IsEnabled="{Binding CanAdd}">
                    <Image Source="gfx/add_to_queue_32dp_5F6368_FILL0_wght400_GRAD0_opsz40.png" Width="28" Height="28"/>
                </Button>
                <Button x:Name="RemoveButton" ToolTip="Delete Run" Click="RemoveButton_Click" IsEnabled="{Binding CanRemove}">
                    <Image Source="gfx/remove_from_queue_32dp_5F6368_FILL0_wght400_GRAD0_opsz40.png" Width="28" Height="28"/>
                </Button>
                <Separator/>
                <Button ToolTip="Run" Command="{Binding RunCommand}">
                    <Image Source="gfx/play_circle_32dp_5F6368_FILL0_wght400_GRAD0_opsz40.png" Width="28" Height="28"/>
                </Button>
                <Button ToolTip="Pause" Command="{Binding PauseCommand}">
                    <Image Source="gfx/pause_circle_32dp_5F6368_FILL0_wght0_GRAD0_opsz40.png" Width="28" Height="28"/>
                </Button>
                <Button ToolTip="Stop" Command="{Binding StopCommand}">
                    <Image Source="gfx/stop_circle_32dp_5F6368_FILL0_wght0_GRAD0_opsz40.png" Width="28" Height="28"/>
                </Button>
                <Separator/>
                <Button ToolTip="Reset Statistics" Command="{Binding ResetStatsCommand}">
                    <Image Source="gfx/reset_32dp_434343_FILL0_wght400_GRAD200_opsz40.png" Width="28" Height="28"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column: run queue + activity meter + stats -->
            <Grid Grid.Column="0" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Height="32" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedLabelText}" Width="40"
                               FontSize="16" VerticalAlignment="Center"/>
                    <Slider x:Name="SpeedSlider" Minimum="0" Maximum="6" Value="{Binding SpeedValue}"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                </DockPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding MeterSlots}" Margin="0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="36" Height="18" Margin="0,0,2,0" Background="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox x:Name="QueueListBox" Grid.Row="2" ItemsSource="{Binding FileQueue}"
                         DisplayMemberPath="Name" SelectionMode="Extended"
                         SelectionChanged="QueueListBox_SelectionChanged"/>

                <TextBlock Grid.Row="3" Height="96" Margin="0,4" TextWrapping="Wrap"
                           Text="Select a single file from the queue for details."/>

                <GroupBox Grid.Row="4" Header="Simulation Statistics" FontSize="13">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Current Run RT:&#10;Sim Run Time:&#10;Total Sim Time:&#10;Total Sim Runs:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" FontFamily="Cascadia Code"
                                   Text="{Binding RunTimeText}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                   FontStyle="Italic" Text="                    Current        All"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Total Scans:&#10;MS1 Scans:&#10;MS2 Scans:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" FontFamily="Cascadia Code"
                                   Text="{Binding ScanStatsText}"/>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock Text="Custom Scan Rate: "/>
                                <TextBlock FontFamily="Cascadia Code" Text="{Binding CurCSRateText}"/>
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Max Custom Scan Rate: "/>
                                <TextBlock FontFamily="Cascadia Code" Text="{Binding MaxCSRateText}"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- Right column: Run Parameters / Real Time Display -->
            <TabControl Grid.Column="1" x:Name="MainTabControl" SelectedIndex="{Binding SelectedTabIndex}">

                <TabItem Header="Run Parameters">
                    <DataGrid x:Name="RunParamsGrid" ItemsSource="{Binding FileList}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                              SelectionChanged="RunParamsGrid_SelectionChanged"
                              PreparingCellForEdit="RunParamsGrid_PreparingCellForEdit">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Binding="{Binding Name}" IsReadOnly="True" Width="2*"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" IsReadOnly="True" Width="3*"/>
                            <DataGridComboBoxColumn x:Name="RunSpanColumn" Header="Run Span"
                                                     SelectedItemBinding="{Binding RunSpan}" Width="150"/>
                            <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="120"/>
                            <DataGridTextColumn Header="End" Binding="{Binding End}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Real Time Display">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <scottplot:WpfPlot x:Name="plotTIC" Grid.Row="0"/>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="6"/>

                        <TabControl Grid.Row="2" TabStripPlacement="Bottom">

                            <TabItem Header="Message Log">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Bottom" Content="Save Log..." Height="30"
                                            Command="{Binding SaveLogCommand}"/>
                                    <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}"
                                             IsReadOnly="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Cascadia Code"/>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Spectrum Viewer">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Margin="3" Text="{Binding ScanNumberLabelText}"/>
                                    <TextBlock DockPanel.Dock="Top" Margin="3" Text="{Binding SpectrumLabelText}"/>
                                    <scottplot:WpfPlot x:Name="plotSpectrum"/>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Custom Scans">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                                        <Button Content="-" Width="28" Command="{Binding CustomScanPreviousCommand}"/>
                                        <TextBox Text="{Binding CustomScanNumber, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="50" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        <Button Content="+" Width="28" Command="{Binding CustomScanNextCommand}"/>
                                        <TextBlock Text=" of " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CustomScanCountText}" VerticalAlignment="Center" Width="30"/>
                                        <TextBlock Text="{Binding CustomScanRTText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <Button Content="Clear" Width="64" Margin="12,0,0,0"
                                                Command="{Binding ClearCustomScansCommand}"/>
                                        <CheckBox Content="Auto-clear Upon Start" VerticalAlignment="Center" Margin="12,0,0,0"
                                                  IsChecked="{Binding ClearCustomScansOnStart}"/>
                                    </StackPanel>
                                    <DataGrid ItemsSource="{Binding CustomScanValues}" AutoGenerateColumns="False"
                                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="Auto"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </DockPanel>
</Window>
